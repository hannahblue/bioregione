# ─── ENVIRONMENT ─────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── DEPENDENCIES ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── NEXT.JS ─────────────────────────────────────────────────────────────────
.next/
out/
build/

# ─── DATA — raw source files are large and have their own licenses ────────────
# Commit only processed/clipped GeoJSON in data/processed/ and data/seed/
data/raw/
data/tmp/

# Specific large files that should never be committed
*.shp
*.dbf
*.shx
*.prj
*.cpg
*.zip
*.tar.gz

# But DO commit these processed files:
!data/processed/**/*.geojson
!data/seed/**/*.geojson
!data/seed/**/*.sql

