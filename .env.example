# Neon Postgres connection string (with PostGIS)
# Get this from your Neon project dashboard: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: separate pooled connection for serverless (Neon recommends this)
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"
