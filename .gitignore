.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─── TYPESCRIPT ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── TESTING ─────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── MISC ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
